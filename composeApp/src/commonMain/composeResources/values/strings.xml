    <string name="welcome_footer">Make sure Ollama is running on your Mac Mini\nand your iPad/Android device is on the same network.</string>

    <!-- HelpView -->
    <string name="help_title">Help</string>
    <string name="help_header_tagline">Chat with AI models on your own server – fast, private, and cloud-free. Version 2.0 (KMP) © 2026 Peter Betz</string>

    <string name="help_section_connection_title">Connection</string>
    <string name="help_connection_server_type_title">Choose server type</string>
    <string name="help_connection_server_type_desc">Choose between Ollama and llama-server. Both backends are supported — Ollama uses its native API, llama-server the OpenAI-compatible API (/v1/chat/completions).</string>
    <string name="help_connection_ip_title">Enter IP address &amp; port</string>
    <string name="help_connection_ip_desc">Tap the connection status in the top left and enter your server\'s IP address (e.g. 192.168.1.100). Default port: Ollama 11434, llama-server 8080.</string>
    <string name="help_connection_reconnect_title">Reconnect</string>
    <string name="help_connection_reconnect_desc">After a disconnect, use \"Reconnect\" to restore the connection without re-entering your settings.</string>
    <string name="help_connection_saved_title">Saved servers</string>
    <string name="help_connection_saved_desc">Recently used server addresses are saved automatically along with their type and can be selected with a tap.</string>

    <string name="help_section_chat_title">Chatting</string>
    <string name="help_chat_send_title">Send a message</string>
    <string name="help_chat_send_desc">Type your message in the input field and tap the arrow button, or press ⌘+Enter on an external keyboard.</string>
    <string name="help_chat_stop_title">Stop generation</string>
    <string name="help_chat_stop_desc">While a response is being generated, a red stop button appears. Use it to cancel generation at any time – the text produced so far is kept.</string>
    <string name="help_chat_copy_title">Copy code</string>
    <string name="help_chat_copy_desc">Code blocks in responses show a \"Copy\" button in the top right. Tap it to copy the code to the clipboard.</string>
    <string name="help_chat_model_title">Switch model</string>
    <string name="help_chat_model_desc">In the top right, choose the active model from the list of all models available on the server.</string>

    <string name="help_section_history_title">Chat history</string>
    <string name="help_history_new_title">New chat</string>
    <string name="help_history_new_desc">Start a new chat using the pencil button in the sidebar or in the top right of the chat.</string>
    <string name="help_history_search_title">Search chats</string>
    <string name="help_history_search_desc">Use the search field in the sidebar to filter chats by title, model, or message content.</string>
    <string name="help_history_rename_title">Rename chat</string>
    <string name="help_history_rename_desc">Long-press a chat in the sidebar and choose \"Rename\" to give the chat a custom title.</string>
    <string name="help_history_export_title">Export chat</string>
    <string name="help_history_export_desc">Export a chat as formatted Markdown text via the context menu (long-press).</string>
    <string name="help_history_delete_title">Delete chat</string>
    <string name="help_history_delete_desc">Delete a chat via the context menu (long-press).</string>

    <string name="help_section_assistant_title">Assistant (Persona · Memory)</string>
    <string name="help_assistant_config_title">Configuration</string>
    <string name="help_assistant_config_desc">In the configuration, you define the assistant\'s name, who you are, and the ground rules for every chat — e.g. language, style, no-gos. Prepended to every chat as a system prompt.</string>
    <string name="help_assistant_soul_title">Personality (Soul)</string>
    <string name="help_assistant_soul_desc">Here you set the vibe: tone, energy, speaking style. These traits define how the assistant sounds — not what it says.</string>
    <string name="help_assistant_memory_title">Memory</string>
    <string name="help_assistant_memory_desc">Persistent facts that stay in mind across all chats. If you ask the assistant in a chat to remember something, it adds the entry itself (via a hidden &lt;remember&gt; tag that\'s removed from the response before you see it).</string>
    <string name="help_assistant_files_title">Files &amp; editability</string>
    <string name="help_assistant_files_desc">Configuration, personality, and memory live as Markdown files in the Assistant folder. You can also edit them with external editors. \"Reload from file\" refreshes the display.</string>
    <string name="help_assistant_toggle_title">Enable/disable</string>
    <string name="help_assistant_toggle_desc">Each of the three building blocks can be enabled or disabled individually — handy for chatting without a personality, or temporarily pausing memory.</string>

    <string name="help_section_params_title">Model parameters</string>
    <string name="help_param_temperature_title">Temperature (0–2)</string>
    <string name="help_param_temperature_desc">Controls the creativity of responses. Low values (e.g. 0.2) give precise, predictable answers. High values (e.g. 1.2) make the model more creative.</string>
    <string name="help_param_topk_title">Top-K (1–200)</string>
    <string name="help_param_topk_desc">Limits token selection to the K most likely next tokens.</string>
    <string name="help_param_topp_title">Top-P (0–1)</string>
    <string name="help_param_topp_desc">Picks tokens from the smallest set whose cumulative probability exceeds P. Works similarly to Top-K, but adaptively.</string>
    <string name="help_param_minp_title">Min-P (0–1)</string>
    <string name="help_param_minp_desc">Cuts off tokens below a minimum probability. 0 = disabled. Helps against unlikely, hallucination-prone tokens.</string>
    <string name="help_param_presence_title">Presence Penalty (0–2)</string>
    <string name="help_param_presence_desc">Penalizes tokens that already appeared — reduces infinite loops. Unsloth often recommends 1.5 for Qwen3.6.</string>

    <string name="help_section_shortcuts_title">Keyboard shortcuts</string>
    <string name="help_shortcut_send_title">⌘ + Enter – Send message</string>
    <string name="help_shortcut_send_desc">On an external keyboard, ⌘+Enter (Command + Return) sends the message directly.</string>

    <string name="help_tip_title">Get the best results</string>
    <string name="help_tip_desc">Combine a precise system prompt with a low temperature (0.1–0.4) for factual tasks like coding or translation. For creative writing, raise temperature to 0.8–1.2 and disable the system prompt.</string>

